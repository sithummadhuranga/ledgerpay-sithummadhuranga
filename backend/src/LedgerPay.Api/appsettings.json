{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Update": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ledgerpay",
    "Audience": "ledgerpay-web",
    "AccessTokenMinutes": 15
  },
  "RateLimits": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Lookup": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Money": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "Enabled": false
  }
}
