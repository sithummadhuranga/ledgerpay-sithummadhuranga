{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ledgerpay",
    "Audience": "ledgerpay-web",
    "AccessTokenMinutes": 15
  },
  "RateLimits": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Lookup": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Money": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "Enabled": false
  }
}
