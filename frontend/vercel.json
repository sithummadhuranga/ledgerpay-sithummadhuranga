{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ledgerpay-api-sm-cfg7b6dabrgxa7dv.indonesiacentral-01.azurewebsites.net/api/:path*" },
    { "source": "/swagger", "destination": "https://ledgerpay-api-sm-cfg7b6dabrgxa7dv.indonesiacentral-01.azurewebsites.net/swagger" },
    { "source": "/swagger/:path*", "destination": "https://ledgerpay-api-sm-cfg7b6dabrgxa7dv.indonesiacentral-01.azurewebsites.net/swagger/:path*" },
    { "source": "/openapi/:path*", "destination": "https://ledgerpay-api-sm-cfg7b6dabrgxa7dv.indonesiacentral-01.azurewebsites.net/openapi/:path*" },
    { "source": "/((?!api/|swagger|openapi/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/((?!api/|swagger|openapi/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
