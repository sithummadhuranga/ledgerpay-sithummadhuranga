# Copy to .env and fill in. .env is git-ignored.
# Every password needs 8+ characters with upper, lower, digit and symbol, or SQL Server rejects it.

# sa account of the local SQL Server container. Only the container setup uses it.
MSSQL_SA_PASSWORD=

# Login that owns the schema. The DbTool connects with it to migrate and seed.
DB_MIGRATOR_PASSWORD=

# Login the API connects with. It cannot update or delete ledger entries or audit logs.
DB_API_PASSWORD=

# Keep single quotes out of the passwords above, the local init script puts them inside T-SQL strings.
# Changing a password here after the first run does not change the logins in an existing volume.
# Run docker compose down -v first to start from scratch.

# The DbTool does not read this file. Give it the migration connection and the seed passwords
# through user-secrets or environment variables, with the same password rules (10 to 128 characters
# with upper, lower, digit and symbol):
#   ConnectionStrings__Migration=Server=localhost,1433;Database=LedgerPay;User Id=ledgerpay_migrator;Password=<DB_MIGRATOR_PASSWORD>;TrustServerCertificate=True
#   Seed__AdminPassword=
#   Seed__OperatorPassword=
#   Seed__CustomerPassword=
# Then run: dotnet run --project backend/tools/LedgerPay.DbTool -- setup
