# Copy to .env and fill in. .env is git-ignored. docker compose reads it.
# Every password needs 10 to 128 characters with upper, lower, digit and symbol.
# Keep single quotes, semicolons and dollar signs out of the passwords: they go into T-SQL strings and
# connection strings.

# sa account of the local SQL Server container. Only the container setup uses it.
MSSQL_SA_PASSWORD=

# Login that owns the schema. The migrate step connects with it to create the tables and the seed data.
DB_MIGRATOR_PASSWORD=

# Login the API connects with. It cannot update or delete ledger entries or audit logs.
DB_API_PASSWORD=

# The API signs its tokens with this key: base64 of at least 32 random bytes,
# for example the output of: openssl rand -base64 48
JWT_SIGNING_KEY=

# Passwords of the seeded admin, operator and customer accounts. The seed stops when one is missing.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Changing a database password here after the first run does not change the logins in an existing volume.
# Run docker compose down -v first to start from scratch.
#
# Run everything:        docker compose up -d --build --wait
# Open the app:          http://localhost:8080       (the API is also on http://localhost:5100/swagger)
#
# Without Docker for the API and the app, keep only the database in compose and give the API and the DbTool
# their settings through user-secrets or environment variables:
#   DbTool:  ConnectionStrings__Migration=Server=localhost,1433;Database=LedgerPay;User Id=ledgerpay_migrator;Password=<DB_MIGRATOR_PASSWORD>;TrustServerCertificate=True
#            Seed__AdminPassword, Seed__OperatorPassword, Seed__CustomerPassword
#            then: dotnet run --project backend/tools/LedgerPay.DbTool -- setup
#   API:     ConnectionStrings__Api=Server=localhost,1433;Database=LedgerPay;User Id=ledgerpay_api;Password=<DB_API_PASSWORD>;TrustServerCertificate=True
#            Jwt__SigningKey=<the key above>
#            then: dotnet run --project backend/src/LedgerPay.Api   (http://localhost:5100)
#   App:     cd frontend && npm run dev   (http://localhost:5173, it passes /api to the API on port 5100)
